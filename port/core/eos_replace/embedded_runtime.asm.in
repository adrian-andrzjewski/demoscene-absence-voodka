; embedded_runtime.asm - the shipped VOODKA runtime payloads.
;
; The canonical archive and module remain byte-for-byte unchanged.  They are
; linked once into the production image and consumed through these symbols;
; individual files are never unpacked or staged beside VOODKA.exe.

BITS 64
DEFAULT REL

section .rdata align=16

global voodka_embedded_archive
global voodka_embedded_archive_end
global voodka_embedded_archive_size
voodka_embedded_archive:
        incbin "@VOODKA_DAT_NASM@"
voodka_embedded_archive_end:
voodka_embedded_archive_size:
        dd voodka_embedded_archive_end - voodka_embedded_archive

align 16
global voodka_embedded_module
global voodka_embedded_module_end
global voodka_embedded_module_size
voodka_embedded_module:
        incbin "@VOODKA_MOD_NASM@"
voodka_embedded_module_end:
voodka_embedded_module_size:
        dd voodka_embedded_module_end - voodka_embedded_module

section .note.GNU-stack noalloc noexec nowrite progbits
